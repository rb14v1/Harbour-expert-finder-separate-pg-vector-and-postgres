# Copy to .env and fill in real values before running docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (plain Postgres - NO pgvector extension needed) ---
# NOTE ON PORTS: this app's Postgres runs on the NATIVE default port 5432.
# That is DIFFERENT from the earlier 6 "AI apps" in this workspace
# (doc-search, faq-chatbot, job-matcher, product-recommender, ticket-triage,
# recipe-finder), whose pgvector-enabled Postgres runs in a Podman container
# on port 5433. There has been real confusion about this before - don't
# point this app at 5433, and don't assume this app needs pgvector at all:
# it stores every relational row in plain Postgres and keeps embeddings in a
# completely separate vector database, Qdrant (see QDRANT_URL below).
POSTGRES_DB=expert_finder
POSTGRES_USER=expert_finder
POSTGRES_PASSWORD=expert_finder
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DEV-ONLY: USE_SQLITE=True runs manage.py commands (check, makemigrations,
# test) against local SQLite + qdrant-client's in-process ":memory:" mode
# (see backend/apps/common/qdrant_store.py) - no Postgres, no Qdrant server,
# no Docker needed at all. This is the default for config.settings.dev, so
# it's set explicitly to False here for clarity when running against real
# services. Never set this to True in docker-compose/production.
USE_SQLITE=False

# --- Vector store (Qdrant) - see backend/apps/common/qdrant_store.py ---
# Leave QDRANT_URL unset (with USE_SQLITE=True) to use the local, in-process
# ":memory:" mode - no server required, identical search behavior. Set
# QDRANT_URL to point at a real Qdrant server, such as the one already
# running at localhost:6333 in this environment (REST) / 6334 (gRPC).
QDRANT_URL=http://localhost:6333

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI (OpenAI) ---
# Leave OPENAI_API_KEY unset to run entirely on deterministic stub
# embeddings (no network access, no cost) - see backend/apps/common/ai.py.
# Set it to enable real OpenAI embeddings.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-5.6-sol
SEARCH_TOP_K=5

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
